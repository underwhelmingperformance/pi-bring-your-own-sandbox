{
	"$schema": "https://unpkg.com/knip/schema.json",
	"workspaces": {
		".": {
			"entry": ["*.config.ts"],
			"project": ["*.config.ts"]
		},
		"packages/sdk": {
			"entry": [
				"src/**/*.test.ts",
				"examples/**/*.test.ts",
				"examples/docker/src/extension.ts",
				"examples/consumer/src/extension.ts"
			],
			"project": ["src/**/*.ts", "examples/**/*.ts", "*.config.ts"]
		},
		"packages/guard": {
			"entry": ["src/**/*.test.ts", "src/extension.ts"],
			"project": ["src/**/*.ts"]
		}
	}
}
