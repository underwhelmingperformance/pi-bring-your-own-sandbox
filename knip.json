{
	"$schema": "https://unpkg.com/knip/schema.json",
	"workspaces": {
		".": {
			"entry": ["*.config.ts"],
			"project": ["*.config.ts"]
		},
		"packages/sdk": {
			"entry": [
				"src/**/*.test.ts",
				"examples/**/*.test.ts",
				"src/fixtures/diagnostics-extension.ts",
				"examples/consumer/src/index.ts!",
				"examples/docker/src/index.ts!",
				"examples/docker/src/shell-profile.ts!"
			],
			"project": [
				"src/**/*.ts!",
				"examples/**/*.ts!",
				"*.config.ts",
				"!src/fixtures/**!",
				"!examples/docker/build-matcher.ts!",
				"!examples/**/test/**!"
			]
		}
	}
}
