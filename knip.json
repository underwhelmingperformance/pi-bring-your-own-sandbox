{
	"$schema": "https://unpkg.com/knip/schema.json",
	"workspaces": {
		".": {
			"entry": ["*.config.ts"],
			"project": ["*.config.ts", "test-support/**/*.ts"]
		},
		"packages/sdk": {
			"entry": [
				"src/**/*.test.ts",
				"src/fixtures/diagnostics-extension.ts",
				"examples/consumer/src/index.ts!"
			],
			"project": [
				"src/**/*.ts!",
				"examples/**/*.ts!",
				"*.config.ts",
				"!src/fixtures/**!",
				"!examples/**/test/**!"
			]
		},
		"packages/provider-docker": {
			"entry": ["test/**/*.test.ts"],
			"project": ["src/**/*.ts!", "test/**/*.ts", "*.ts"]
		}
	}
}
