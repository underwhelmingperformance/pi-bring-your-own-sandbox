{
	"$schema": "https://unpkg.com/knip/schema.json",
	"workspaces": {
		".": {
			"entry": ["*.config.ts"],
			"project": ["*.config.ts", "test-support/**/*.ts"]
		},
		"packages/sdk": {
			"entry": [
				"src/**/*.test.ts",
				"src/fixtures/diagnostics-extension.ts",
				"src/consumer.ts!",
				"src/embedding-host.ts!",
				"src/pi-tools.ts!",
				"src/provider.ts!",
				"src/provider-kit.ts!",
				"src/review.ts!",
				"src/testing.ts!",
				"src/target-file.ts!",
				"src/target-search.ts!",
				"examples/consumer/src/index.ts!"
			],
			"project": [
				"src/**/*.ts!",
				"examples/**/*.ts!",
				"*.config.ts",
				"!src/fixtures/**!"
			]
		},
		"packages/provider-docker": {
			"entry": [
				"test/**/*.test.ts",
				"src/index.ts!",
				"src/shell-profile.ts!",
				"src/import-helper.ts!",
				"src/launcher.ts!"
			],
			"project": ["src/**/*.ts!", "test/**/*.ts", "*.ts"]
		}
	}
}
