{
	"name": "pi-byos-workspace",
	"version": "0.0.0",
	"private": true,
	"description": "Development workspace for the BYOS SDK and guard",
	"type": "module",
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "pnpm -r --if-present build",
		"check": "pnpm build && pnpm run --sequential '/^check:.*/'",
		"check:format": "prettier --check .",
		"check:knip": "knip --include dependencies,unlisted --no-progress",
		"check:lint": "eslint . --max-warnings 0",
		"check:markdown": "markdownlint-cli2 '**/*.md' '#**/node_modules' '#**/dist'",
		"check:test": "pnpm test",
		"check:types": "tsc --noEmit && pnpm -r --if-present check:types",
		"fix": "pnpm fix:lint && pnpm fix:format",
		"fix:format": "prettier --write .",
		"fix:lint": "eslint . --fix",
		"test": "pnpm -r --if-present test",
		"test:integration": "pnpm -r --if-present test:integration",
		"test:provider": "pnpm -r --if-present test:provider",
		"test:package": "pnpm -r --if-present test:package"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"@types/node": "24.12.2",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-simple-import-sort": "14.0.0",
		"eslint-plugin-unicorn": "79.0.0",
		"globals": "17.13.0",
		"jiti": "2.7.0",
		"knip": "6.43.0",
		"markdownlint-cli2": "0.24.0",
		"prettier": "3.9.10",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1"
	},
	"license": "MIT"
}
