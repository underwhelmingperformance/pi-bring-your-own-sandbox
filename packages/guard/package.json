{
	"name": "pi-bring-your-own-sandbox-guard",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"dependencies": {
		"pi-bring-your-own-sandbox": "workspace:^"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.5.2",
		"@types/node": "24.19.2",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"vitest": "5.1.0"
	},
	"description": "Require an activated sandbox provider for BYOS SDK operations",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"pi": {
		"extensions": [
			"./src/extension.ts"
		]
	},
	"files": [
		"src",
		"dist",
		"!src/**/*.test.ts",
		"README.md"
	],
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -b tsconfig.build.json --force",
		"check:types": "tsc --noEmit",
		"test": "pnpm build && vitest run"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "1.5.2"
	}
}
