{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"rootDir": "src",
		"outDir": "dist",
		"declaration": true,
		"sourceMap": true,
		"inlineSources": true,
		"composite": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/*.test.ts"],
	"references": [
		{
			"path": "../sdk/tsconfig.build.json"
		}
	]
}
