{
	"name": "pi-byos-provider-docker",
	"version": "0.0.0",
	"private": true,
	"description": "Docker sandbox provider for Pi",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./shell-profile": {
			"types": "./src/shell-profile.ts",
			"import": "./src/shell-profile.ts"
		}
	},
	"files": [
		"src",
		"dist/re2js.mjs",
		"dist/RE2JS-LICENSE",
		"scripts/rename-race-probe.sh",
		"workspace-editing.md",
		"README.md"
	],
	"license": "MIT",
	"scripts": {
		"build": "node build-matcher.ts",
		"test": "pnpm build && vitest run",
		"test:provider": "pnpm --filter pi-bring-your-own-sandbox build && pnpm build && vitest run --config vitest.provider.config.ts",
		"test:package": "pnpm --filter pi-bring-your-own-sandbox build && pnpm build && vitest run --config vitest.package.config.ts",
		"check:types": "tsc --noEmit"
	},
	"dependencies": {
		"pi-bring-your-own-sandbox": "workspace:*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@types/node": "24.19.2",
		"re2js": "2.10.0",
		"typebox": "1.3.27",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"vitest": "5.1.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "1.5.0",
		"typebox": "1.3.27"
	}
}
