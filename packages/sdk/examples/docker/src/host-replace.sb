(version 1)
(allow default)
(deny file-write*)
(allow file-write-unlink
    (require-all (subpath (param "STAGING"))
                 (require-not (file-attribute has-multiple-names))))
(allow file-write*
    (require-all (subpath (param "WORKSPACE"))
                 (require-not (file-attribute has-multiple-names))))
(deny file-write* (subpath (param "PROTECTED")))
(deny file-write* (subpath (string-append (param "WORKSPACE") "/.git")))
(deny file-write* (subpath (string-append (param "WORKSPACE") "/.envrc")))
(deny file-write* (subpath (string-append (param "WORKSPACE") "/.direnv")))
(deny file-write* (subpath (string-append (param "WORKSPACE") "/.vscode")))
(deny file-write* (subpath (string-append (param "WORKSPACE") "/.idea")))
(deny file-write* (subpath (string-append (param "WORKSPACE") "/.devcontainer")))
(deny file-link)
