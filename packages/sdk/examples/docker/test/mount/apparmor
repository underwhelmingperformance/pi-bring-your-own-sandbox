#include <tunables/global>

profile byos-mount-probe flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  capability sys_admin,
  capability setpcap,
  capability setuid,
  capability setgid,
  network unix seqpacket,

  mount fstype=fuse -> /workspace/,
  umount /control/,

  /mount-check rix,
  /usr/bin/setpriv rix,
  /usr/bin/sleep rix,
  /usr/bin/{bash,cat,dash} rix,
  /usr/local/bin/node mrix,
  /usr/lib/** mr,
  /etc/{passwd,group,nsswitch.conf} r,
  /dev/fuse rw,
  /control/service rw,
  /workspace/ r,
  /workspace/** rw,
  /opt/pi-byos/node_modules/re2js/ r,
  /opt/pi-byos/node_modules/re2js/{index.mjs,package.json} rw,
  @{PROC}/@{pid}/status r,
  @{PROC}/1/comm r,
}
