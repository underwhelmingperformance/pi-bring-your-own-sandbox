#include <tunables/global>

profile byos-mount-probe flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  capability sys_admin,
  capability setpcap,
  capability setuid,
  capability setgid,
  network unix seqpacket,

  mount fstype=fuse -> /workspace/,
  umount /control/,

  /mount-check rix,
  /usr/bin/setpriv rix,
  /usr/bin/dash rix,
  /usr/local/bin/node mrix,
  /usr/lib/** mr,
  /etc/{passwd,group,nsswitch.conf} r,
  /dev/fuse rw,
  /control/service rw,
  /workspace/ r,
  /workspace/source.txt rw,
  /workspace/truncate.txt rw,
  /workspace/alias r,
  /workspace/host-ready r,
  @{PROC}/@{pid}/status r,
}
