(version 1)
(allow default)
(deny file-write*)
(allow file-write*
    (require-all (subpath (param "WORKSPACE"))
                 (require-not (file-attribute has-multiple-names))))
(deny file-write* (subpath (param "PROTECTED")))
(deny file-link)
(deny file-write-unlink (literal (param "PROTECTED_PARENT")))
