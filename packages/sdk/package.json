{
	"name": "pi-bring-your-own-sandbox",
	"version": "0.0.0",
	"private": true,
	"description": "A provider-neutral sandbox framework for Pi extensions",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"exports": {
		"./api": {
			"types": "./src/api.ts",
			"import": "./src/api.ts"
		},
		"./pi-tools": {
			"types": "./src/pi-tools.ts",
			"import": "./src/pi-tools.ts"
		},
		"./testing": {
			"types": "./src/testing.ts",
			"import": "./src/testing.ts"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/fixtures/**",
		"docs",
		"examples/docker/README.md",
		"examples/docker/src",
		"examples/consumer/README.md",
		"examples/consumer/src",
		"README.md"
	],
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "1.5.0",
		"typebox": "1.4.3",
		"vitest": "5.0.5 || 5.1.0"
	},
	"peerDependenciesMeta": {
		"vitest": {
			"optional": true
		}
	},
	"license": "MIT",
	"publishConfig": {
		"exports": {
			"./api": {
				"types": "./dist/api.d.ts",
				"import": "./dist/api.js"
			},
			"./pi-tools": {
				"types": "./dist/pi-tools.d.ts",
				"import": "./dist/pi-tools.js"
			},
			"./testing": {
				"types": "./dist/testing.d.ts",
				"import": "./dist/testing.js"
			}
		}
	},
	"scripts": {
		"build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -b tsconfig.build.json --force",
		"test": "pnpm build && vitest run",
		"test:integration": "pnpm build && vitest run src/*integration.test.ts src/user-shell-rpc.test.ts examples/consumer/test/integration.test.ts",
		"test:provider": "pnpm build && vitest run --config vitest.provider.config.ts",
		"test:package": "vitest run --config vitest.package.config.ts",
		"check:types": "tsc --noEmit"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@types/node": "24.19.2",
		"jiti": "2.7.0",
		"typebox": "1.4.3",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"vitest": "5.1.0"
	}
}
